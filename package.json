{
  "name": "obsidian-anki-blocks",
  "version": "0.1.0",
  "description": "Sync flashcard blocks in Obsidian with Anki.",
  "keywords": [],
  "license": "MIT",
  "author": "Jeppe Klitgaard <hi@jeppe.science>",
  "main": "main.js",
  "scripts": {
    "build": "npm run check && node esbuild.config.mjs production && npm run sass:ci",
    "check": "tsc --noEmit --skipLibCheck",
    "check:watch": "npm run check -- --watch",
    "dev": "node esbuild.config.mjs",
    "sass:dev": "sass --no-source-map --watch sass/main.scss styles.css",
    "sass:ci": "sass --no-source-map sass/main.scss styles.css",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --quiet",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest",
    "test:dev": "jest --watch",
    "test:ci": "jest --ci --runInBand"
  },
  "devDependencies": {
    "@popperjs/core": "2.11.2",
    "@types/glob": "7.2.0",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "4.0.5",
    "@types/lodash": "4.14.178",
    "@types/node": "14.14.45",
    "@typescript-eslint/eslint-plugin": "5.10.0",
    "@typescript-eslint/parser": "5.10.0",
    "esbuild": "0.28.2",
    "eslint": "8.7.0",
    "eslint-config-prettier": "8.3.0",
    "eslint-import-resolver-node": "0.3.6",
    "eslint-import-resolver-typescript": "2.5.0",
    "eslint-plugin-import": "2.25.4",
    "eslint-plugin-prettier": "4.0.0",
    "eslint-plugin-simple-import-sort": "7.0.0",
    "eslint-plugin-unused-imports": "2.0.0",
    "file-type": "17.1.1",
    "glob": "7.2.0",
    "jest": "30.5.2",
    "js-yaml": "4.1.0",
    "lodash": "4.17.21",
    "obsidian": "0.13.21",
    "peggy": "1.2.0",
    "prettier": "2.5.1",
    "promise-all-properties": "3.0.4",
    "sass": "1.105.0",
    "ts-jest": "29.4.13",
    "tslib": "2.5.0",
    "typescript": "5.9.3",
    "yup": "0.32.11"
  },
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  }
}
